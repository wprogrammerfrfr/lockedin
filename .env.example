# Public Supabase (safe for the browser). Set these in Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Canonical site origin (production). Leave unset locally so localhost still works.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* or commit it.
#
# Dashboard (not env): enable Email + Google + GitHub Auth, paste emails/*.html
# templates, configure SMTP, allowlist /auth/callback, apply supabase/migrations.
